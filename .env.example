# Copia este archivo a .env y rellena los valores. NO subas .env a git.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=TRAFFIC_ACCIDENTS_WH
# Opcional: warehouse distinto por entorno (si no, se usa SNOWFLAKE_WAREHOUSE)
# DEV_SNOWFLAKE_WAREHOUSE=
# PRO_SNOWFLAKE_WAREHOUSE=

# Entorno activo: DEV o PRO (decide bases de datos DEV_*_DB / PRO_*_DB y CSV a cargar)
APP_ENV=DEV

# Dos orígenes por entorno. En PRO: el CSV completo + la muestra (así hay ~773 mil repetidos que silver deduplica).
# Si *_CSV_2 no se indica se carga el mismo archivo que *_CSV_1.
DEV_CSV_1=C:/Users/satur/Documents/PROYECTOS/TRAFFIC_ACCIDENTS/US_Accidents_sample10.csv
DEV_CSV_2=C:/Users/satur/Documents/PROYECTOS/TRAFFIC_ACCIDENTS/US_Accidents_sample10.csv
PRO_CSV_1=C:/Users/satur/Documents/PROYECTOS/TRAFFIC_ACCIDENTS/US_Accidents_March23.csv
PRO_CSV_2=C:/Users/satur/Documents/PROYECTOS/TRAFFIC_ACCIDENTS/US_Accidents_sample10.csv

# Para sample_csv.py: genera DEV_CSV_1 a partir de PRO_CSV_1
SAMPLE_PERCENT=10
